/* Hoard Noir: black ground, one orange accent, a few quiet greys.
 *
 *   #000000  every surface            #F79646  focus, active, live, errors, titles
 *   #FFFFFF  primary text             #7B4B23  frames and the logo shadow at rest
 *   #888888  secondary text, labels   #262626  tracks and dividers
 *
 * The page is a set of framed panels with their titles set into the border, like the tools it
 * keeps company with (lazygit, btop, k9s). A frame is dim orange at rest and full orange while
 * anything inside it has focus; buttons are plain words that turn into an orange block on focus.
 * Orange is reserved for meaning: where you are, what is alive, what needs you.
 */

* {
    background: #000000;
    color: #FFFFFF;
    scrollbar-background: #000000;
    scrollbar-background-hover: #000000;
    scrollbar-background-active: #000000;
    scrollbar-color: #262626;
    scrollbar-color-hover: #F79646;
    scrollbar-color-active: #F79646;
    scrollbar-size: 1 1;
}

/* Textual lightens focused widgets with a tint; the ground must stay black. */
*:focus, *:hover {
    background-tint: transparent;
}

App, Screen, ModalScreen, Container, Horizontal, Vertical, VerticalScroll, Grid,
Header, Footer, Static, Label, Input, TextArea, OptionList, ListView, DataTable,
Select, SelectOverlay, SelectionList, Button {
    background: #000000;
}

Screen {
    layout: vertical;
}

/* ── chrome ─────────────────────────────────────────────────────────────── */

#hoard-header {
    height: 1;
    padding: 0 2;
}

#screen-body {
    height: 1fr;
    min-height: 1;
    padding: 0 1;
}

#statusbar {
    height: 1;
    padding: 0 2;
    color: #888888;
}

#content {
    width: 1fr;
    height: 100%;
}

#workspace {
    width: 100%;
    height: 1fr;
    min-width: 1;
    padding: 0;
}

#action-feedback {
    display: none;
    height: auto;
    max-height: 3;
    padding: 0 2;
    color: #FFFFFF;
}

#status-error {
    display: none;
    height: auto;
    min-height: 3;
    color: #F79646;
    border-left: solid #F79646;
    padding-left: 1;
    margin-bottom: 1;
}

/* One text axis: a button keeps one blank column inside its label, so every other block
   starts one column in as well and labels, text and table cells line up. */
#workspace Static, .dialog Static, .dialog Label {
    padding-left: 1;
}

/* ── panels ─────────────────────────────────────────────────────────────── */

.panel {
    height: auto;
    padding: 0 1 0 0;
    border: round #7B4B23;
    border-title-color: #F79646;
    border-title-background: #000000;
    border-title-style: bold;
    border-title-align: left;
    border-subtitle-color: #888888;
    border-subtitle-background: #000000;
    border-subtitle-align: right;
}

.panel:focus-within {
    border: round #F79646;
}

#sidebar {
    width: 22;
    min-width: 18;
    height: 100%;
    margin-right: 1;
    padding: 0 1;
}

.sidebar-hidden #sidebar {
    display: none;
}

#navigation, #navigation-secondary {
    height: auto;
    max-height: 100%;
    min-height: 4;
    border: none;
    padding: 0;
    background: #000000;
}

#navigation:focus, #navigation-secondary:focus {
    border: none;
    background: #000000;
}

#workspace-navigation {
    width: 100%;
    height: 100%;
}

#workspace-navigation #navigation {
    height: 1fr;
    min-height: 3;
}

#workspace-navigation #navigation-secondary {
    height: 2;
    min-height: 2;
}

OptionList > .option-list--option,
OptionList > .option-list--option-highlighted,
OptionList > .option-list--option-hover,
OptionList > .option-list--option-disabled,
OptionList > .option-list--separator,
OptionList:focus > .option-list--option,
OptionList:focus > .option-list--option-highlighted {
    background: #000000;
}

OptionList > .option-list--option {
    color: #FFFFFF;
}

OptionList > .option-list--option-highlighted,
OptionList > .option-list--option-hover {
    color: #F79646;
    text-style: bold;
}

/* The selection bar: an orange block while the list has the keyboard. */
OptionList:focus > .option-list--option-highlighted {
    color: #F79646;
    text-style: bold reverse;
}

OptionList > .option-list--option-disabled {
    color: #888888;
}

OptionList > .option-list--separator {
    color: #262626;
}

/* ── masthead: the big wordmark when there is room, the small one otherwise ─ */

.hero {
    height: auto;
    margin-bottom: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}

.hero-small {
    display: none;
}

.short .hero-big, .compact .hero-big {
    display: none;
}

.short .hero-small, .compact .hero-small {
    display: block;
}

.tiny .hero-small {
    display: none;
}

/* ── Home ───────────────────────────────────────────────────────────────── */

#telegram-monitor-panel {
    height: auto;
    min-height: 8;
}

#telegram-monitor, #home-summary {
    height: auto;
    min-height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#workspace #telegram-monitor {
    padding-left: 0;
}

#home-summary {
    margin-top: 1;
}

.compact #telegram-monitor-panel, .tiny #telegram-monitor-panel {
    min-height: 5;
}

#current-action, #progress, #telegram-current, #telegram-statistics,
#account-summary, #web-summary,
#tools, #statistics, #queue-stats, #events {
    height: auto;
    min-height: 1;
}

/* Legacy status widgets remain available to non-Home consumers. */
#current-action, #progress, #events, #statistics, #queue-stats, #tools {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ── Telegram ───────────────────────────────────────────────────────────── */

#collector-panel, #telegram-statistics-panel {
    height: auto;
}

#telegram-statistics-panel {
    margin-top: 1;
}

#telegram-current, #telegram-statistics {
    height: auto;
    min-height: 1;
}

#sources-panel {
    height: 1fr;
    min-height: 9;
}

#source-summary-panel {
    height: auto;
    margin-top: 1;
}

#source-filters {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#source-search {
    width: 1fr;
}

#source-filter {
    width: 18;
    margin-left: 2;
}

#source-sort {
    width: 24;
    margin-left: 2;
}

#sources-table {
    height: 1fr;
    min-height: 3;
}

#source-pagination {
    width: 100%;
    height: 1;
    margin-top: 1;
}

#source-range {
    width: 1fr;
    height: 1;
    color: #888888;
}

#source-pagination Button {
    margin-left: 3;
}

#source-summary {
    height: auto;
    min-height: 1;
    margin-bottom: 1;
}

.short #sources-panel {
    height: auto;
}

.short #sources-table, .tiny #sources-table {
    height: 5;
}

.compact #source-filters {
    layout: vertical;
    height: 9;
}

.compact #source-search, .compact #source-filter, .compact #source-sort {
    width: 100%;
    margin-left: 0;
}

/* Contextual publication viewer: one active table, independent server pages. */
#publication-summary-panel, #publication-object-panel, #publication-operations-panel {
    height: auto;
}

#publication-content-panel {
    height: 1fr;
    min-height: 8;
    margin-top: 1;
}

#publication-summary, #publication-object {
    height: auto;
    min-height: 1;
    margin-bottom: 1;
}

#publication-table {
    height: 1fr;
    min-height: 3;
}

#publication-profile-search {
    display: none;
    width: 100%;
    margin-bottom: 1;
}

#publication-pagination {
    width: 100%;
    height: 1;
    margin-top: 1;
}

#publication-range {
    width: 1fr;
    height: 1;
    color: #888888;
}

#publication-pagination Button {
    margin-left: 3;
}

#publication-actions {
    grid-size: 5;
}

#publication-selection-actions {
    grid-size: 3;
}

#publication-frame-actions {
    grid-size: 4;
}

#publication-psl-controls {
    layout: grid;
    grid-size: 4;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-rows: 1;
    grid-gutter: 0 2;
    width: 100%;
    height: auto;
    min-height: 1;
    margin-bottom: 1;
}

#publication-psl-mode {
    width: 100%;
}

#publication-frame-status, #publication-batch-status {
    height: auto;
    color: #888888;
    margin-top: 1;
}

.short #publication-content-panel {
    height: auto;
}

.short #publication-table, .tiny #publication-table {
    height: 4;
}

.medium #publication-actions {
    grid-size: 3;
}

.medium #publication-selection-actions, .medium #publication-frame-actions,
.medium #publication-psl-controls {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto;
}

.compact #publication-actions {
    grid-size: 1;
}

.compact #publication-selection-actions, .compact #publication-frame-actions,
.compact #publication-psl-controls {
    grid-size: 1;
    grid-columns: 1fr;
    grid-rows: auto;
}

.compact #publication-modes {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    height: auto;
}

.compact #publication-modes Button {
    margin-right: 0;
}

/* ── Archive ────────────────────────────────────────────────────────────── */

#archive-main {
    height: 1fr;
    min-height: 12;
}

#archive-table {
    height: 1fr;
    min-height: 3;
}

/* On short terminals the panel must grow with its controls; a 1fr panel clips the
   table and lower action rows outside the scrollable workspace. */
.short #archive-main {
    height: auto;
}

.short #archive-table {
    height: 4;
}

.tiny #archive-table {
    height: 4;
}

#archive-summary, #ai-summary, #ai-statistics, #ai-history,
#telegram-ai-photos, #telegram-ai-previous {
    height: auto;
    min-height: 1;
    margin-bottom: 1;
}

#archive-summary {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.table-help {
    color: #888888;
}

/* ── actions: words in a row, never boxes ───────────────────────────────── */

Button,
Button:hover, Button:focus, Button:disabled,
Button.-primary, Button.-primary:hover, Button.-primary:focus,
Button.-default, Button.-default:hover, Button.-default:focus,
Button.-active {
    background: #000000;
    background-tint: transparent;
    tint: transparent;
    border: none;
}

Button {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0;
    color: #FFFFFF;
    text-style: none;
    text-align: left;
    content-align: left middle;
}

Button:hover {
    color: #F79646;
}

Button.-primary {
    color: #F79646;
    text-style: bold;
}

Button:focus, Button.-primary:focus {
    color: #F79646;
    text-style: bold reverse;
}

Button:disabled {
    color: #888888;
    text-style: none;
    opacity: 70%;
}

.action-row {
    layout: grid;
    grid-size: 3;
    grid-columns: auto;
    grid-rows: 1;
    grid-gutter: 0 3;
    width: 100%;
    height: auto;
    min-height: 1;
    margin-bottom: 1;
}

#telegram-actions {
    grid-size: 4;
    margin-bottom: 0;
}

#telegram-statistics-actions {
    grid-size: 1;
}

#account-actions {
    grid-size: 4;
    margin-bottom: 0;
}

#source-actions {
    grid-size: 5;
}

#web-actions {
    grid-size: 3;
}

#source-ai-actions {
    grid-size: 3;
}

#archive-actions, #archive-advanced, #frame-actions, #ai-actions {
    grid-size: 3;
}

.narrow #telegram-actions, .narrow #account-actions {
    grid-size: 2;
}

.medium #source-actions {
    grid-size: 3;
}

.narrow #source-actions {
    grid-size: 2;
}

.medium #source-ai-actions {
    grid-size: 2;
}

.medium #archive-actions, .medium #archive-advanced, .medium #frame-actions,
.medium #ai-actions {
    grid-size: 2;
}

.compact #telegram-actions, .compact #account-actions, .compact #source-actions, .compact #source-ai-actions,
.compact #web-actions {
    grid-size: 2;
}

.compact #archive-actions, .compact #archive-advanced, .compact #frame-actions,
.compact #ai-actions {
    grid-size: 1;
}

/* Modes are tabs: the chosen one is orange and underlined. */
.mode-row {
    layout: horizontal;
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

.mode-row Button {
    color: #888888;
    margin-right: 3;
}

.mode-row Button:hover {
    color: #FFFFFF;
}

.mode-row Button.-primary {
    color: #F79646;
    text-style: bold underline;
}

.mode-row Button:focus, .mode-row Button.-primary:focus {
    color: #F79646;
    text-style: bold reverse;
}

#archive-more {
    color: #888888;
    margin-right: 0;
}

#profiles-page-label {
    width: auto;
    height: 1;
    margin-right: 2;
    color: #888888;
}

.compact #archive-modes {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    height: auto;
}

.compact #archive-modes Button {
    margin-right: 0;
}

.compact #profile-pages {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr auto 1fr;
    grid-gutter: 0 1;
    height: auto;
}

.compact #profile-pages Button {
    margin-right: 0;
    width: auto;
}

.narrow .ai-mode-row Button {
    margin-right: 1;
}

.compact .ai-mode-row {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-gutter: 0 1;
    height: auto;
}

.compact .ai-mode-row Button {
    margin-right: 0;
}

/* ── fields and tables ──────────────────────────────────────────────────── */

Input, Input:focus, Input:hover {
    background: #000000;
    border: none;
    border-bottom: solid #262626;
    height: 2;
    padding: 0 1;
}

Input:focus {
    border-bottom: solid #F79646;
}

Input > .input--placeholder {
    color: #888888;
}

TextArea, TextArea:focus, TextArea:hover {
    background: #000000;
    border: solid #262626;
}

TextArea:focus {
    border: solid #F79646;
}

Select, Select:focus, Select:hover {
    background: #000000;
    border: none;
}

SelectOverlay, SelectionList, SelectionList:focus, SelectionList:hover {
    background: #000000;
    border: solid #262626;
}

SelectionList:focus, SelectOverlay:focus {
    border: solid #F79646;
}

SelectCurrent, SelectCurrent:focus, SelectCurrent:hover,
Select:focus > SelectCurrent, Select.-expanded > SelectCurrent {
    background: #000000;
    border: none;
    border-bottom: solid #262626;
    padding: 0;
}

Select:focus > SelectCurrent, Select.-expanded > SelectCurrent {
    border-bottom: solid #F79646;
}

DataTable, DataTable:focus, DataTable:hover {
    background: #000000;
    border: none;
    padding: 0;
}

DataTable > .datatable--header,
DataTable > .datatable--fixed,
DataTable:focus > .datatable--header {
    background: #000000;
    color: #888888;
    text-style: bold;
}

/* The row under the cursor is orange text; while the table has the keyboard it is a block. */
DataTable > .datatable--cursor {
    background: #000000;
    color: #F79646;
    text-style: bold;
}

DataTable:focus > .datatable--cursor {
    background: #000000;
    color: #F79646;
    text-style: bold reverse;
}

DataTable > .datatable--hover {
    background: #000000;
    color: #FFFFFF;
}

DataTable > .datatable--header-cursor,
DataTable > .datatable--header-hover,
DataTable > .datatable--fixed-cursor,
DataTable:focus > .datatable--fixed-cursor {
    background: #000000;
    color: #F79646;
}

DataTable:focus > .datatable--header {
    background-tint: transparent;
}

SelectionList > .selection-list--button,
SelectionList > .selection-list--button-selected,
SelectOverlay > .option-list--option,
SelectOverlay > .option-list--option-highlighted,
SelectOverlay > .option-list--option-hover {
    background: #000000;
}

#profile-source-filter {
    width: 48;
    max-width: 100%;
    margin-bottom: 1;
}

/* ── AI workspace ───────────────────────────────────────────────────────── */

#ai-main {
    min-height: 10;
}

#ai-list-pane {
    height: auto;
}

#ai-table {
    width: 100%;
    height: 16;
    min-height: 4;
}

.medium #ai-table {
    height: 12;
}

.short #ai-table {
    height: 6;
}

.tiny #ai-table {
    height: 4;
}

.ai-mode-row {
    margin-bottom: 1;
}

#ai-chat-pane {
    height: auto;
}

.section-heading, #ai-chat-title {
    height: 1;
    color: #F79646;
    text-style: bold;
}

#ai-message, #record-content, #record-schema, #telegram-ai-content {
    height: 7;
    min-height: 4;
    margin-bottom: 1;
}

#ai-onboarding {
    width: 100%;
    max-width: 58;
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border-left: solid #F79646;
}

#ai-onboarding Button {
    margin-top: 1;
}

.ai-record-dialog, .telegram-ai-dialog, .telegram-analysis-dialog {
    width: 80;
}

.telegram-analysis-dialog {
    height: 90%;
}

#analysis-scroll {
    height: 1fr;
}

.analysis-pages {
    height: 3;
}

.telegram-analysis-dialog SelectionList {
    height: auto;
    min-height: 3;
    max-height: 14;
    margin-bottom: 1;
    border: solid #262626;
}

/* ── modals: framed in full orange ──────────────────────────────────────── */

ModalScreen {
    align: center middle;
    background: #000000;
}

#help-card {
    width: 58;
    max-width: 94%;
    height: auto;
    max-height: 96%;
    padding: 1 3;
    background: #000000;
    color: #FFFFFF;
    border: round #F79646;
}

#help-text {
    height: auto;
}

PaletteScreen {
    align: center top;
}

#palette {
    width: 66;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    margin-top: 3;
    padding: 1 2;
    border: round #F79646;
}

.short #palette {
    margin-top: 1;
}

.tiny #palette {
    margin-top: 0;
}

#palette-input, #palette-input:focus, #palette-input:hover {
    height: 1;
    border: none;
    padding: 0;
}

#palette-rule {
    height: 1;
    margin-top: 1;
}

#palette-list {
    height: auto;
    max-height: 14;
    border: none;
    padding: 0;
}

.dialog {
    width: 72;
    max-width: 94%;
    height: auto;
    max-height: 94%;
    padding: 1 3;
    border: round #F79646;
    background: #000000;
}

#confirm-dialog {
    width: 62;
}

.dialog-title {
    height: 2;
    color: #F79646;
    text-style: bold;
}

.dialog-message, .dialog-error {
    height: auto;
    min-height: 1;
    margin-bottom: 0;
}

.dialog-error {
    color: #F79646;
}

.field-label {
    height: 1;
    margin-top: 1;
    color: #888888;
}

.dialog Input {
    width: 100%;
    margin-bottom: 0;
}

.dialog Select {
    width: 100%;
    margin-bottom: 0;
}

.dialog-actions {
    layout: horizontal;
    width: 100%;
    height: auto;
    min-height: 1;
    margin-top: 1;
}

.dialog-actions Button {
    width: auto;
    margin-right: 3;
}

.compact .dialog {
    padding: 0 2;
}

.compact .dialog-actions {
    layout: vertical;
}

.compact .dialog-actions Button {
    width: 100%;
    margin-right: 0;
}
