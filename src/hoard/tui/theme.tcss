$background: #000000;
$text: #FFFFFF;
$text-muted: #888888;
$accent: #F79646;
$separator: #262626;

* {
    background: #000000;
    color: #FFFFFF;
    scrollbar-background: #000000;
    scrollbar-background-hover: #000000;
    scrollbar-background-active: #000000;
    scrollbar-color: #262626;
    scrollbar-color-hover: #F79646;
    scrollbar-color-active: #F79646;
}

App, Screen, ModalScreen, Container, Horizontal, Vertical, VerticalScroll,
Header, Footer, Static, Label, Input, TextArea, OptionList, ListView, DataTable,
Select, SelectOverlay, SelectionList {
    background: #000000;
}

Screen {
    layout: vertical;
}

#hoard-header {
    height: 2;
    padding: 0 1;
    content-align: left middle;
    border-bottom: solid #262626;
}

#screen-body {
    height: 1fr;
    min-height: 1;
}

#sidebar {
    width: 23;
    min-width: 18;
    height: 100%;
    padding: 1;
    border-right: solid #262626;
}

.sidebar-hidden #sidebar {
    display: none;
}

.eyebrow, .section-heading {
    color: #F79646;
    text-style: bold;
}

.eyebrow {
    height: 2;
}

#navigation {
    height: auto;
    min-height: 3;
    border: none;
    padding: 0;
    background: #000000;
}

#navigation:focus {
    border: none;
    background: #000000;
}

OptionList > .option-list--option,
OptionList > .option-list--option-highlighted,
OptionList > .option-list--option-hover,
OptionList > .option-list--option-disabled,
OptionList > .option-list--separator {
    background: #000000;
}

OptionList > .option-list--option-highlighted,
OptionList > .option-list--option-hover {
    color: #F79646;
    text-style: bold;
}

#workspace {
    width: 1fr;
    height: 100%;
    min-width: 1;
    padding: 1 2;
    background: #000000;
}

.compact #workspace {
    padding: 0 1;
}

.screen-title {
    height: 2;
    color: #FFFFFF;
    text-style: bold;
}

.screen-subtitle {
    height: 2;
    color: #888888;
}

#status-error {
    display: none;
    height: auto;
    min-height: 3;
    color: #F79646;
    border-left: solid #F79646;
    padding-left: 1;
    margin-bottom: 1;
}

#overview-grid {
    height: auto;
    min-height: 10;
}

#system-summary, #statistics {
    width: 1fr;
    height: auto;
    min-height: 8;
}

.compact #overview-grid {
    layout: vertical;
    min-height: 16;
}

.compact #system-summary, .compact #statistics {
    width: 100%;
}

.section-heading {
    height: 2;
    margin-top: 1;
    border-bottom: solid #262626;
}

#events, #progress, #current-action, #activity-queue {
    height: auto;
    min-height: 2;
    padding-top: 1;
}

#progress {
    min-height: 4;
}

#statusbar {
    height: 2;
    padding: 0 1;
    color: #888888;
    content-align: left middle;
    border-top: solid #262626;
}

.compact #statusbar {
    height: 2;
}

Input, TextArea, DataTable, Select, SelectOverlay, SelectionList,
Input:focus, TextArea:focus, DataTable:focus, Select:focus,
Input:hover, TextArea:hover, DataTable:hover, Select:hover {
    background: #000000;
    border: solid #262626;
}

DataTable > .datatable--cursor,
DataTable > .datatable--hover,
DataTable > .datatable--header,
DataTable > .datatable--fixed,
SelectionList > .selection-list--button,
SelectionList > .selection-list--button-selected,
SelectOverlay > .option-list--option,
SelectOverlay > .option-list--option-highlighted,
SelectOverlay > .option-list--option-hover {
    background: #000000;
}

ModalScreen {
    align: center middle;
    background: #000000;
}

#help-card {
    width: 54;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: #000000;
    color: #FFFFFF;
    border: solid #F79646;
}
